# =============================================================================
# Rust / Cargo
# =============================================================================

# 编译产物
/target/          # Cargo 的默认输出目录[reference:1][reference:2]
**/target/         # 递归匹配所有 target 目录[reference:3][reference:4]

# 调试信息文件 (Windows MSVC)
*.pdb             # MSVC 工具链生成的程序数据库文件[reference:5]

# =============================================================================
# 依赖锁定文件 (Cargo.lock)
# =============================================================================

# 对于库项目，建议提交 Cargo.lock；对于应用项目，可以忽略[reference:7][reference:8]
# Cargo.lock

# =============================================================================
# 开发工具文件
# =============================================================================

# rustfmt 备份文件
**/*.rs.bk        # rustfmt 格式化时产生的备份[reference:9][reference:10]

# 崩溃报告
rustc-ice-*.txt   # 编译器内部错误（ICE）报告[reference:11]

# =============================================================================
# IDE / 编辑器
# =============================================================================

# JetBrains IDEs (RustRover, CLion, IntelliJ IDEA)
.idea/            # JetBrains 项目配置目录
*.iml             # JetBrains 模块文件[reference:13]

# Visual Studio Code
.vscode/          # VS Code 工作区配置

# 通用编辑器临时文件
*.swp             # Vim 交换文件
*.swo             # Vim 交换文件
*~                # 备份文件

# =============================================================================
# 操作系统
# =============================================================================

# macOS
.DS_Store         # Finder 元数据文件

# Windows
Thumbs.db         # 缩略图缓存

# =============================================================================
# 测试 / 基准测试 / Fuzzing
# =============================================================================

# 代码覆盖率
/coverage/        # 覆盖率报告输出目录
*.profraw         # LLVM 覆盖率原始数据
*.profdata        # LLVM 覆盖率处理后的数据

# Criterion 基准测试
/target/criterion/ # Criterion 基准测试结果

# Fuzzing
/fuzz/target/     # Fuzz 目标输出
/fuzz/corpus/     # Fuzz 语料库
/fuzz/artifacts/  # Fuzz 产物

# =============================================================================
# 环境变量 / 密钥
# =============================================================================

.env              # 环境变量文件
.env.local        # 本地环境变量文件
*.secret          # 密钥文件[reference:29]
